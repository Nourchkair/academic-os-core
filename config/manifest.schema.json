{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academia OS local profile",
  "type": "object",
  "required": ["schema_version", "student", "academic", "runtime", "automation", "acquisition", "privacy", "agents"],
  "properties": {
    "schema_version": {"const": 2},
    "student": {
      "type": "object",
      "required": ["name", "institution", "program"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "institution": {"type": "string", "minLength": 1},
        "program": {"type": "string"}
      },
      "additionalProperties": true
    },
    "academic": {
      "type": "object",
      "required": ["semester", "timezone", "root_directory"],
      "properties": {
        "semester": {"type": "string", "pattern": "^(Winter|Spring|Summer|Fall) [0-9]{4}$"},
        "timezone": {"type": "string", "minLength": 1},
        "root_directory": {"type": "string", "minLength": 1},
        "school_portal": {"type": "string"}
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["install_directory"],
      "properties": {"install_directory": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "automation": {
      "type": "object",
      "properties": {
        "daily_brief_enabled": {"type": "boolean"},
        "daily_brief_time": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
        "inbox_processor_enabled": {"type": "boolean"},
        "inbox_interval_minutes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "acquisition": {
      "type": "object",
      "properties": {
        "manual_import_enabled": {"type": "boolean"},
        "watched_folders": {"type": "array", "items": {"type": "string"}},
        "browser_companion_enabled": {"type": "boolean"},
        "browser_access_enabled": {"type": "boolean"},
        "advanced_browser_enabled": {"type": "boolean"},
        "allowed_sites": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "privacy": {
      "type": "object",
      "properties": {
        "browser_access_enabled": {"type": "boolean"},
        "allowed_sites": {"type": "array", "items": {"type": "string"}},
        "dedicated_profile_recommended": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "agents": {"type": "object", "additionalProperties": {"type": "object"}}
  },
  "additionalProperties": true
}
