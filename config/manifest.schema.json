{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academia OS local profile",
  "type": "object",
  "required": ["schema_version", "student", "academic", "runtime", "acquisition", "privacy", "browser", "agents"],
  "properties": {
    "schema_version": {"const": 3},
    "student": {
      "type": "object",
      "required": ["name", "institution", "program"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "institution": {"type": "string", "minLength": 1},
        "program": {"type": "string"}
      },
      "additionalProperties": true
    },
    "academic": {
      "type": "object",
      "required": ["semester", "timezone", "root_directory"],
      "properties": {
        "semester": {"type": "string", "pattern": "^(Winter|Spring|Summer|Fall) [0-9]{4}$"},
        "timezone": {"type": "string", "minLength": 1},
        "root_directory": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["install_directory"],
      "properties": {"install_directory": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "legacy_compatibility": {
      "type": "object",
      "deprecated": true,
      "description": "Deprecated pre-playbook fields retained only for migration and old adapter compatibility. Not current Academia OS state.",
      "properties": {
        "deprecated": {"const": true},
        "source": {"type": "string"},
        "description": {"type": "string"},
        "integrations": {"type": "object"},
        "automation": {"type": "object"},
        "school_portal_name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "acquisition": {
      "type": "object",
      "properties": {
        "manual_import_enabled": {"type": "boolean"},
        "watched_folders": {"type": "array", "items": {"type": "string"}},
        "browser_companion_enabled": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "privacy": {
      "type": "object",
      "properties": {
        "dedicated_profile_recommended": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "browser": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "user_data_dir": {"type": "string"},
        "profile_directory": {"type": "string"},
        "access_enabled": {"type": "boolean"},
        "allowed_sites": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "agents": {"type": "object", "additionalProperties": {"type": "object"}}
  },
  "additionalProperties": true
}
