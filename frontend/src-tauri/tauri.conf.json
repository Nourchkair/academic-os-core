{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Academia OS",
  "version": "0.4.0",
  "identifier": "com.academia.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title": "Academia OS", "width": 1280, "height": 840, "minWidth": 980, "minHeight": 660}],
    "security": {"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "macOS": {"minimumSystemVersion": "13.0"}
  }
}
