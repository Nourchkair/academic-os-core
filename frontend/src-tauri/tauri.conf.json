{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AcademiaOS",
  "version": "0.4.12",
  "identifier": "com.academia.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build && npm run bundle:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AcademiaOS",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/academia"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4NzVGODVFRkI0NEM0N0IKUldSN3hFVDdYdmgxYURJYnF2a0VkOVFGYXdIeWFyVWcvWkdyNm1sVFRxcXhwZVd1SmhnTjRReFkK",
      "endpoints": [
        "https://github.com/Nourchkair/academic-os-core/releases/latest/download/latest.json"
      ]
    }
  }
}
